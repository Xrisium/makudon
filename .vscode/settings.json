{
  "files.encoding": "utf8",
  "files.eol": "\n",
  "editor.insertSpaces": true,
  "editor.tabSize": 4,
  "files.exclude": {"**/.gradle": true, "**/.kotlin": true},
  "search.exclude": {"**/build": true, "**/.gradle": true, "**/.local": true},
  "intellij.buildTool": "gradle",
  "intellij.workspace.reloadOnBuildFileSave": "prompt",
  "[kotlin]": {"editor.defaultFormatter": "jetbrains.kotlin-server"}
}
